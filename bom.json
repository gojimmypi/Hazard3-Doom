{
  "$schema": "https://cyclonedx.org/schema/bom-1.7.schema.json",
  "bomFormat": "CycloneDX",
  "specVersion": "1.7",
  "version": 1,
  "metadata": {
    "component": {
      "type": "application",
      "bom-ref": "hazard3-doom",
      "group": "ulx3s",
      "name": "Hazard3-Doom",
      "version": "0.2.0",
      "description": "Doom running on the Hazard3 RISC-V CPU in an ECP5 FPGA, including monitor firmware, a DoomGeneric application, FPGA board integrations, host-side upload/flashing tools, and supporting project assets.",
      "externalReferences": [
        {
          "type": "vcs",
          "url": "https://github.com/ulx3s/Hazard3-Doom"
        },
        {
          "type": "documentation",
          "url": "https://hazard3-doom.readthedocs.io/"
        },
        {
          "type": "license",
          "url": "https://github.com/ulx3s/Hazard3-Doom/blob/main/LICENSING.md"
        },
        {
          "type": "evidence",
          "url": "https://github.com/ulx3s/Hazard3-Doom/blob/main/LICENSES/BUNDLED-BINARIES-MANIFEST.md",
          "comment": "Repository release-audit manifest for redistributed binaries and DLLs."
        }
      ],
      "properties": [
        {
          "name": "hazard3-doom:sbom-mode",
          "value": "checked-in"
        },
        {
          "name": "hazard3-doom:licensing-model",
          "value": "Multi-license, per-file/per-component; see LICENSING.md and LICENSES/ notices."
        },
        {
          "name": "hazard3-doom:sbom-scope",
          "value": "Source tree, pinned source submodules, known bundled third-party components, and Git-tracked redistributed convenience binaries."
        },
        {
          "name": "hazard3-doom:excluded-content",
          "value": "DOOM IWAD/game data is not distributed by Hazard3-Doom and is not part of this SBOM."
        },
        {
          "name": "hazard3-doom:build-environment",
          "value": "External build toolchains are not modeled unless they are redistributed in the repository."
        }
      ]
    },
    "properties": [
      {
        "name": "hazard3-doom:sbom-generation-policy",
        "value": "Do not invent missing versions or provenance. Regenerate for releases and replace unresolved fields when exact artifacts are known."
      },
      {
        "name": "hazard3-doom:generator",
        "value": "scripts/generate-sbom.py"
      }
    ]
  },
  "components": [
    {
      "type": "library",
      "bom-ref": "coremark",
      "name": "CoreMark",
      "scope": "excluded",
      "description": "EEMBC CoreMark benchmark material used for benchmarking and verification rather than the Doom runtime.",
      "licenses": [
        {
          "license": {
            "id": "Apache-2.0",
            "acknowledgement": "declared"
          }
        }
      ],
      "externalReferences": [
        {
          "type": "vcs",
          "url": "https://github.com/eembc/coremark"
        }
      ],
      "properties": [
        {
          "name": "hazard3-doom:provenance-status",
          "value": "Exact upstream revision is not established by the current root notice; preserve nested provenance when redistributed."
        }
      ]
    },
    {
