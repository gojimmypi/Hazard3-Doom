# v73 CI seed-sweep synthesis only. Never pack or flash this target.
# Produces the same RTL defines and source list as v73-build, but starts
# with a SHA-pinned full-SERV v63c-derived command without needing an
# untracked reference .bit on a GitHub Actions runner.
include Makefile.ulx5m-v73-integrated
.DEFAULT_GOAL := v73-gh-help

.PHONY: v73-gh-help v73-gh-synth
v73-gh-help:
	@echo 'v73-gh-synth: generate CI-only seed-search netlist, NOT a qualified bitstream'

v73-gh-synth: $(SERV_STAMP) $(SERV_RTL) $(PROBE_MC)
	@mkdir -p $(V73_DIR)
	@test -s $(PROBE_MC) || { echo "[FAIL] Missing or empty USB transaction microcode: $(PROBE_MC)"; exit 1; }
	python3 tests/v73-gh-bootstrap-rom.py --output $(V73_CMD)
	$(MAKE) -C fw -f Makefile.ulx5m-flash-read -B all \
	  BUILD_DIR=../$(V73_DIR) SERV=1 NORMAL_BOOT_EXPERIMENT=1 \
	  DFU_STREAM_ONLY=1 DFU_HW_TEST_ONLY=1 DFU_HW_NATIVE_TEST_ONLY=1 \
	  NATIVE_SPI_SECONDARY=1
	@sha256sum rtl/ulx5m_spi_active_reboot_wb.v \
	  rtl/top-ulx5m-gs-flash-read.v $(V73_FW) \
	  Makefile.ulx5m-v73-integrated > $(V73_SOURCE)
	$(YOSYS) -p 'read_verilog -defer $(V73_DEFINES) -Icores/usb/rtl $(V73_SRC); synth_gatemate -top $(V73_TOP) -luttree -nomx8 -json $(abspath $(V73_JSON))' > $(V73_DIR)/synth-gh.log
	python3 tests/v73-gh-bootstrap-rom.py --output $(V73_CMD) --check
	@test -s $(V73_JSON) || { echo '[FAIL] Empty v73 synthesized netlist'; exit 1; }
	@echo '[PASS] v73 integrated CI netlist generated for 48MHz timing sweep ONLY'
