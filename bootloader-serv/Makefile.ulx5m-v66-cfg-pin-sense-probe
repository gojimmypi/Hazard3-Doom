# ULX5M-GS v66: local synthesis and gmpack ONLY; no programmer or flash target.
# Comparator with hardware-proven v65, differs by 6 INPUT-ONLY flash GPIOs.
.DEFAULT_GOAL := help
YOSYS ?= yosys
NEXTPNR ?= nextpnr-himbaechel
GMPACK ?= gmpack
DEVICE ?= CCGM1A1
V66_SEED ?= 302
V66_BASE := build-ulx5m-gs/v66-cfg-pin-sense
V66_TOP := top_ulx5m_gs_v66_cfg_pin_sense_probe
V66_SRC := rtl/top-ulx5m-gs-v66-cfg-pin-sense-probe.v
V66_CCF := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.ccf
V66_SDC := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.sdc
V66_JSON := $(V66_BASE)/$(V66_TOP).json
V66_IMPL := $(V66_BASE)/$(V66_TOP)-seed$(V66_SEED).txt
V66_BIT := $(V66_BASE)/$(V66_TOP)-seed$(V66_SEED)-PACK-ONLY.bit
V66_BOOTADDR := 2101248
.DELETE_ON_ERROR: $(V66_IMPL) $(V66_BIT)
.PHONY: help v66-build v66-test
help:
	@echo 'v66 local-only: make -f Makefile.ulx5m-v66-cfg-pin-sense-probe v66-test'
	@echo 'v66 local-only: make -f Makefile.ulx5m-v66-cfg-pin-sense-probe v66-build'
	@echo 'No JTAG, flash programming, installer, USB DFU or device access.'
v66-test:
	python3 tests/test-ulx5m-v66-cfg-pin-sense-probe.py
v66-build: $(V66_BIT)
$(V66_BASE):
	mkdir -p $@
$(V66_JSON): $(V66_SRC) $(V66_CCF) $(V66_SDC) | $(V66_BASE)
	$(YOSYS) -p 'read_verilog -defer $(V66_SRC); synth_gatemate -top $(V66_TOP) -luttree -nomx8 -json $(abspath $@)' > $(V66_BASE)/synth.log
$(V66_IMPL): $(V66_JSON) $(V66_CCF) $(V66_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(V66_JSON)) -o ccf=$(abspath $(V66_CCF)) -o out=$(abspath $@) --sdc $(abspath $(V66_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(V66_SEED) -l $(abspath $(V66_BASE)/pnr-seed$(V66_SEED).log)
$(V66_BIT): $(V66_IMPL)
	$(GMPACK) --bootaddr $(V66_BOOTADDR) $(abspath $<) $(abspath $@)
	python3 tests/qualify-ulx5m-v66-cfg-pin-sense-probe.py $(abspath $@) --pnr-log $(abspath $(V66_BASE)/pnr-seed$(V66_SEED).log)
