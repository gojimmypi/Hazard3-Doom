# ULX5M-GS GateMate bring-up. Separate from original ECP5 Makefile.
# Safe first target: FPGA RAM-only LED + PLL image; no flash programming.

# Default placement seed for ULX5M-GS SERV bootloader.
SERV_SEED ?= 260

YOSYS ?= yosys
NEXTPNR ?= nextpnr-himbaechel
GMPACK ?= gmpack
DEVICE ?= CCGM1A1
BUILD_DIR ?= build-ulx5m-gs

TOP := top_ulx5m_gs_bringup
SRC := rtl/top-ulx5m-gs-bringup.v rtl/sysmgr_gatemate.v
CCF := data/top-ulx5m-gs-bringup.ccf
SDC := data/top-ulx5m-gs-bringup.sdc
JSON := $(BUILD_DIR)/$(TOP).json
IMPL := $(BUILD_DIR)/$(TOP).txt
BIT := $(BUILD_DIR)/$(TOP).bit

.DEFAULT_GOAL := help
.PHONY: help bringup usb-monitor usb-probe check flash dfu clean

help:
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs bringup'
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs usb-monitor'
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs usb-probe'
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs flash-read-probe'
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs flash-read-serv (experimental)'
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs dfu-stage-serv (RAM-only, no flash writes)'
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs dfu-stream-serv (discard-only, no flash writes)'
	@echo 'ULX5M-GS: make -f Makefile.ulx5m-gs test-flash-serv-firmware'
	@echo 'Produces a volatile JTAG-loadable LED/PLL bitstream (NOT DFU).'
	@echo 'USB monitor is RX-only with no attach, and will NOT enumerate.'
	@echo 'USB probe enumerates a non-programmable DFU interface from JTAG RAM.'
	@echo 'flash-read-probe allows only read-only JEDEC ID/flash data via vendor USB.'
	@echo 'SERV test also uses the read-only flash diagnostic and cannot write flash.'
	@echo 'No flash-writing targets are provided.'

bringup: $(BIT)

# Independent, RX-only USB pad test. No DFU firmware and no flash access.
USB_TOP := top_ulx5m_gs_usb_monitor
USB_SRC := rtl/top-ulx5m-gs-usb-monitor.v rtl/sysmgr_gatemate.v cores/usb/rtl/usb_phy.v
USB_CCF := data/top-ulx5m-gs-usb-monitor.ccf
USB_SDC := data/top-ulx5m-gs-usb-monitor.sdc
USB_JSON := $(BUILD_DIR)/$(USB_TOP).json
USB_IMPL := $(BUILD_DIR)/$(USB_TOP).txt
USB_BIT := $(BUILD_DIR)/$(USB_TOP).bit

usb-monitor: $(USB_BIT)

$(USB_JSON): $(USB_SRC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog -defer $(USB_SRC); synth_gatemate -top $(USB_TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/usb-monitor-synth.log

$(USB_IMPL): $(USB_JSON) $(USB_CCF) $(USB_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(USB_JSON)) -o ccf=$(abspath $(USB_CCF)) -o out=$(abspath $@) --sdc $(abspath $(USB_SDC)) --router router2 --placer-heap-beta=0.6 -l $(abspath $(BUILD_DIR)/usb-monitor-pnr.log)

$(USB_BIT): $(USB_IMPL)
	$(GMPACK) $(abspath $(USB_IMPL)) $(abspath $@)


# PicoRV32 + USB controller enumeration probe, RAM-only; no flash access.
# NOTE: compile firmware first so synth_gatemate can initialize BRAM directly.
PROBE_TOP := top_ulx5m_gs_usb_probe
PROBE_FW := $(BUILD_DIR)/fw_ulx5m_probe.hex
PROBE_MC := $(BUILD_DIR)/usb_trans_mc.hex
PROBE_SRC := rtl/top-ulx5m-gs-usb-probe.v rtl/soc_ulx5m_misc.v \
  rtl/sysmgr_gatemate.v rtl/picorv32.v rtl/soc_bridge.v rtl/soc_bram.v \
  rtl/soc_mem_response_reg.v \
  cores/misc/rtl/uart_wb.v cores/misc/rtl/uart_tx.v \
  cores/misc/rtl/uart_rx.v cores/misc/rtl/uart_irda_tx.v \
  cores/misc/rtl/uart_irda_rx.v cores/misc/rtl/fifo_sync_ram.v \
  cores/misc/rtl/glitch_filter.v cores/misc/rtl/ram_sdp.v \
  cores/misc/rtl/fifo_sync_shift.v \
  $(wildcard cores/usb/rtl/*.v)
PROBE_CCF := data/top-ulx5m-gs-usb-probe.ccf
PROBE_SDC := data/top-ulx5m-gs-usb-probe.sdc
PROBE_JSON := $(BUILD_DIR)/$(PROBE_TOP).json
PROBE_IMPL := $(BUILD_DIR)/$(PROBE_TOP).txt
PROBE_BIT := $(BUILD_DIR)/$(PROBE_TOP).bit

.PHONY: usb-probe test-usb-probe-bus
usb-probe: $(PROBE_BIT)

# Exercise the complete PicoRV32-to-BRAM/Wishbone handshake in simulation.
# No USB PHY or configuration flash is instantiated by this test.
test-usb-probe-bus: | $(BUILD_DIR)
	iverilog -g2012 -s tb_ulx5m_probe_bus -o $(BUILD_DIR)/probe-bus-test.vvp \
	  rtl/picorv32.v rtl/soc_bridge.v rtl/soc_bram.v \
	  rtl/soc_mem_response_reg.v tests/tb_ulx5m_probe_bus.v
	vvp $(BUILD_DIR)/probe-bus-test.vvp

$(PROBE_FW): $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S fw/lnk-app.lds fw/Makefile.ulx5m-gs
	$(MAKE) -C fw -f Makefile.ulx5m-gs

$(PROBE_MC): cores/usb/utils/microcode.py | $(BUILD_DIR)
	python3 $< > $@

$(PROBE_JSON): $(PROBE_SRC) $(PROBE_FW) $(PROBE_MC) $(PROBE_CCF) $(PROBE_SDC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog -defer -Icores/usb/rtl $(PROBE_SRC); synth_gatemate -top $(PROBE_TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/usb-probe-synth.log

$(PROBE_IMPL): $(PROBE_JSON) $(PROBE_CCF) $(PROBE_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(PROBE_JSON)) -o ccf=$(abspath $(PROBE_CCF)) -o out=$(abspath $@) --sdc $(abspath $(PROBE_SDC)) --router router2 --placer-heap-beta=0.6 -l $(abspath $(BUILD_DIR)/usb-probe-pnr.log)

$(PROBE_BIT): $(PROBE_IMPL)
	$(GMPACK) $(abspath $(PROBE_IMPL)) $(abspath $@)


# Independent, volatile, read-only flash ID/data diagnostic.
# The optional BRAM request pipeline is enabled only by this top.
# Never modify usb-probe or its firmware/constraint sources.
FLASH_TOP := top_ulx5m_gs_flash_read
FLASH_FW := $(BUILD_DIR)/fw_ulx5m_flash_read.hex
FLASH_SRC := $(filter-out rtl/top-ulx5m-gs-usb-probe.v,$(PROBE_SRC)) \
  rtl/top-ulx5m-gs-flash-read.v rtl/qspi_master_wb.v \
  rtl/qspi_phy_gatemate.v
FLASH_CCF := data/top-ulx5m-gs-flash-read.ccf
FLASH_SDC := data/top-ulx5m-gs-flash-read.sdc
FLASH_JSON := $(BUILD_DIR)/$(FLASH_TOP).json
FLASH_IMPL := $(BUILD_DIR)/$(FLASH_TOP).txt
FLASH_BIT := $(BUILD_DIR)/$(FLASH_TOP).bit

.PHONY: flash-read-probe
flash-read-probe: $(FLASH_BIT)

.PHONY: test-flash-bram-pipe
test-flash-bram-pipe: | $(BUILD_DIR)
	iverilog -g2012 -s tb_ulx5m_flash_bram_pipe -o $(BUILD_DIR)/flash-bram-pipe-test.vvp \
	  rtl/picorv32.v rtl/soc_bridge.v rtl/soc_bram.v \
	  rtl/soc_mem_response_reg.v tests/tb_ulx5m_flash_bram_pipe.v
	vvp $(BUILD_DIR)/flash-bram-pipe-test.vvp

$(FLASH_FW): $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S fw/lnk-app.lds fw/Makefile.ulx5m-flash-read
	$(MAKE) -C fw -f Makefile.ulx5m-flash-read

$(FLASH_JSON): $(FLASH_SRC) $(FLASH_FW) $(PROBE_MC) $(FLASH_CCF) $(FLASH_SDC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog -defer -Icores/usb/rtl $(FLASH_SRC); synth_gatemate -top $(FLASH_TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/flash-read-synth.log

$(FLASH_IMPL): $(FLASH_JSON) $(FLASH_CCF) $(FLASH_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(FLASH_JSON)) -o ccf=$(abspath $(FLASH_CCF)) -o out=$(abspath $@) --sdc $(abspath $(FLASH_SDC)) --router router2 --placer-heap-beta=0.6 -l $(abspath $(BUILD_DIR)/flash-read-pnr.log)

$(FLASH_BIT): $(FLASH_IMPL)
	$(GMPACK) $(abspath $(FLASH_IMPL)) $(abspath $@)

# Experimental SERV replacement for the read-only flash diagnostic.
# Keep PicoRV32 targets and bitstreams intact. This does not write flash.
SERV_DIR ?= third_party/serv
SERV_TAG := 1.4.0
SERV_COMMIT := 7d9cde4
# Keep the verification stamp out of the pinned upstream Git checkout.
SERV_STAMP := $(BUILD_DIR)/serv-1.4.0.stamp
SERV_RTL := $(addprefix $(SERV_DIR)/rtl/, \
  serv_bufreg.v serv_bufreg2.v serv_alu.v serv_csr.v serv_ctrl.v \
  serv_decode.v serv_immdec.v serv_mem_if.v serv_rf_if.v \
  serv_rf_ram_if.v serv_rf_ram.v serv_state.v serv_debug.v \
  serv_top.v serv_rf_top.v serv_aligner.v serv_compdec.v)
SERV_FW := $(BUILD_DIR)/serv/fw_ulx5m_flash_read.hex
SERV_SRC := $(filter-out rtl/picorv32.v,$(FLASH_SRC)) rtl/soc_serv_cpu.v $(SERV_RTL)
SERV_JSON := $(BUILD_DIR)/$(FLASH_TOP)-serv.json
SERV_IMPL := $(BUILD_DIR)/$(FLASH_TOP)-serv.txt
SERV_BIT := $(BUILD_DIR)/$(FLASH_TOP)-serv.bit
# Distinct streaming USB DFU experiment. Does not modify the proven staging
# image, read-only SERV image, JTAG or external configuration flash.
DFU_STREAM_FW := $(BUILD_DIR)/dfu-stream/fw_ulx5m_flash_read.hex
DFU_STREAM_JSON := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-stream.json
DFU_STREAM_IMPL := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-stream.txt
DFU_STREAM_BIT := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-stream.bit

.PHONY: dfu-stream-serv dfu-stream-serv-firmware
dfu-stream-serv: $(DFU_STREAM_BIT)
dfu-stream-serv-firmware: $(DFU_STREAM_FW)

$(DFU_STREAM_FW): $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S fw/lnk-app.lds fw/Makefile.ulx5m-flash-read
	$(MAKE) -C fw -f Makefile.ulx5m-flash-read \
	  BUILD_DIR=../$(BUILD_DIR)/dfu-stream SERV=1 DFU_STREAM_ONLY=1

$(DFU_STREAM_JSON): $(DFU_STREAM_FW) $(PROBE_MC) $(SERV_STAMP) $(SERV_SRC) $(FLASH_CCF) $(FLASH_SDC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog -defer -DULX5M_USE_SERV -DULX5M_SERV_DFU_STREAM -Icores/usb/rtl $(SERV_SRC); synth_gatemate -top $(FLASH_TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/dfu-stream-serv-synth.log

$(DFU_STREAM_IMPL): $(DFU_STREAM_JSON) $(FLASH_CCF) $(FLASH_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(DFU_STREAM_JSON)) -o ccf=$(abspath $(FLASH_CCF)) -o out=$(abspath $@) --sdc $(abspath $(FLASH_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(SERV_SEED) -l $(abspath $(BUILD_DIR)/dfu-stream-serv-pnr.log)

$(DFU_STREAM_BIT): $(DFU_STREAM_IMPL)
	$(GMPACK) $(abspath $(DFU_STREAM_IMPL)) $(abspath $@)

# Icarus cannot resolve a forward declaration in pinned SERV 1.4.0.
# Generate a build-only state copy; leave the pinned upstream checkout intact.
SERV_SIM_STATE := $(BUILD_DIR)/serv_state_iverilog.v
SERV_SIM_RTL := $(filter-out $(SERV_DIR)/rtl/serv_state.v,$(SERV_RTL)) $(SERV_SIM_STATE)

.PHONY: flash-read-serv test-flash-serv-bus check-serv
flash-read-serv: $(SERV_BIT)

check-serv:
	python3 tests/check-ulx5m-gs-port.py
	python3 tests/check-ulx5m-gs-probe.py
	python3 tests/check-ulx5m-gs-flash-read.py
	python3 tests/check-ulx5m-gs-serv.py

# Pin upstream SERV to a specific official release and verify the commit.
# An existing checkout must be at the same revision (never overwrite it).
$(SERV_STAMP): | $(BUILD_DIR)
	@if [ ! -d '$(SERV_DIR)/.git' ]; then \
	  if [ -e '$(SERV_DIR)' ]; then \
	    echo 'ERROR: SERV_DIR exists but is not a git checkout' >&2; exit 1; \
	  fi; \
	  mkdir -p '$(dir $(SERV_DIR))'; \
	  git clone --quiet --depth 1 --branch '$(SERV_TAG)' \
	    https://github.com/olofk/serv.git '$(SERV_DIR)' || exit 1; \
	fi
	@rev=$$(git -C '$(SERV_DIR)' rev-parse --short=7 HEAD) || exit 1; \
	  if [ "$$rev" != '$(SERV_COMMIT)' ]; then \
	    echo "ERROR: expected SERV $(SERV_COMMIT), found $$rev" >&2; exit 1; \
	  fi
	@test -f '$(SERV_DIR)/rtl/serv_rf_top.v' || exit 1
	@touch '$@'

# Source files appear when the pinned SERV checkout has been fetched.
$(SERV_RTL): $(SERV_STAMP)
	@test -f '$@' || { echo 'ERROR: missing SERV source $@' >&2; exit 1; }

$(SERV_FW): $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S fw/lnk-app.lds fw/Makefile.ulx5m-flash-read
	$(MAKE) -C fw -f Makefile.ulx5m-flash-read \
	  BUILD_DIR=../$(BUILD_DIR)/serv SERV=1

$(SERV_JSON): $(SERV_FW) $(PROBE_MC) $(SERV_STAMP) $(SERV_SRC) $(FLASH_CCF) $(FLASH_SDC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog -defer -DULX5M_USE_SERV -Icores/usb/rtl $(SERV_SRC); synth_gatemate -top $(FLASH_TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/flash-read-serv-synth.log

$(SERV_IMPL): $(SERV_JSON) $(FLASH_CCF) $(FLASH_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(SERV_JSON)) -o ccf=$(abspath $(FLASH_CCF)) -o out=$(abspath $@) --sdc $(abspath $(FLASH_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(SERV_SEED) -l $(abspath $(BUILD_DIR)/flash-read-serv-pnr.log)

$(SERV_BIT): $(SERV_IMPL)
	$(GMPACK) $(abspath $(SERV_IMPL)) $(abspath $@)

# Separate DFU-RAM staging image. Never overwrite the read-only SERV image.
# The RTL define selects the independent BRAM init file at synthesis time.
# This target performs ONLY firmware compile, FPGA synthesis/PnR and packing.
# It does NOT communicate with JTAG or program configuration flash.
DFU_STAGE_FW := $(BUILD_DIR)/dfu-stage/fw_ulx5m_flash_read.hex
DFU_STAGE_JSON := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-stage.json
DFU_STAGE_IMPL := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-stage.txt
DFU_STAGE_BIT := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-stage.bit

.PHONY: dfu-stage-serv dfu-stage-serv-firmware
dfu-stage-serv: $(DFU_STAGE_BIT)
dfu-stage-serv-firmware: $(DFU_STAGE_FW)

$(DFU_STAGE_FW): $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S fw/lnk-app.lds fw/Makefile.ulx5m-flash-read
	$(MAKE) -C fw -f Makefile.ulx5m-flash-read \
	  BUILD_DIR=../$(BUILD_DIR)/dfu-stage SERV=1 DFU_STAGE_ONLY=1

$(DFU_STAGE_JSON): $(DFU_STAGE_FW) $(PROBE_MC) $(SERV_STAMP) $(SERV_SRC) $(FLASH_CCF) $(FLASH_SDC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog -defer -DULX5M_USE_SERV -DULX5M_SERV_DFU_STAGE -Icores/usb/rtl $(SERV_SRC); synth_gatemate -top $(FLASH_TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/dfu-stage-serv-synth.log

$(DFU_STAGE_IMPL): $(DFU_STAGE_JSON) $(FLASH_CCF) $(FLASH_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(DFU_STAGE_JSON)) -o ccf=$(abspath $(FLASH_CCF)) -o out=$(abspath $@) --sdc $(abspath $(FLASH_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(SERV_SEED) -l $(abspath $(BUILD_DIR)/dfu-stage-serv-pnr.log)

$(DFU_STAGE_BIT): $(DFU_STAGE_IMPL)
	$(GMPACK) $(abspath $(DFU_STAGE_IMPL)) $(abspath $@)

# SERV 1.4.0 uses trap_pending before its declaration. Icarus needs it
# declared first. Synthesis continues to use the exact pinned upstream RTL.
$(SERV_SIM_STATE): $(SERV_DIR)/rtl/serv_state.v tests/prepare-ulx5m-serv-iverilog.py | $(BUILD_DIR)
	python3 tests/prepare-ulx5m-serv-iverilog.py $< $@

# Same RV32I RAM/MMIO transaction test as the PicoRV32 baseline.
test-flash-serv-bus: $(SERV_STAMP) $(SERV_SIM_STATE) | $(BUILD_DIR)
	iverilog -g2012 -s tb_ulx5m_serv_flash_bram_pipe -o $(BUILD_DIR)/flash-serv-bus-test.vvp \
	  $(SERV_SIM_RTL) rtl/soc_serv_cpu.v rtl/soc_bridge.v rtl/soc_bram.v \
	  rtl/soc_mem_response_reg.v tests/tb_ulx5m_serv_flash_bram_pipe.v
	vvp $(BUILD_DIR)/flash-serv-bus-test.vvp

# Check the SERV-only trace CSR read pipeline without USB cable or JTAG.
.PHONY: test-flash-serv-ep0-trace
test-flash-serv-ep0-trace: $(PROBE_MC) | $(BUILD_DIR)
	iverilog -g2012 -Icores/usb/rtl -s tb_ulx5m_serv_ep0_trace_csr \
	  -o $(BUILD_DIR)/flash-serv-ep0-trace-test.vvp \
	  $(wildcard cores/usb/rtl/*.v) tests/tb_ulx5m_serv_ep0_trace_csr.v
	vvp $(BUILD_DIR)/flash-serv-ep0-trace-test.vvp

# Exercise real USB PHY/RX LL and packet ACK decoding at 4 clocks/bit.
.PHONY: test-flash-serv-ep0-ack

test-flash-serv-ep0-ack: $(PROBE_MC) | $(BUILD_DIR)
	iverilog -g2012 -Icores/usb/rtl -s tb_ulx5m_serv_ep0_ack_path \
	  -o $(BUILD_DIR)/flash-serv-ep0-ack-test.vvp \
	  $(wildcard cores/usb/rtl/*.v) tests/tb_ulx5m_serv_ep0_ack_path.v
	vvp $(BUILD_DIR)/flash-serv-ep0-ack-test.vvp

# Simulated capture RAM/CSR readout (no USB host or GateMate primitives).
.PHONY: test-flash-serv-raw-capture
test-flash-serv-raw-capture: | $(BUILD_DIR)
	iverilog -g2012 -s tb_ulx5m_serv_raw_capture -o $(BUILD_DIR)/flash-serv-raw-capture-test.vvp \
	  cores/usb/rtl/usb_ep0_raw_capture.v tests/tb_ulx5m_serv_raw_capture.v
	vvp $(BUILD_DIR)/flash-serv-raw-capture-test.vvp
	python3 tests/capture-ulx5m-serv-ep0-raw.py --selftest

# Independently decode device DATA TX waveform (PID, payload, CRC16, EOP).
# Does not force host ACK or modify the USB RTL/firmware.
.PHONY: test-flash-serv-tx-packet
test-flash-serv-tx-packet: | $(BUILD_DIR)
	iverilog -g2012 -Icores/usb/rtl -s tb_ulx5m_serv_tx_packet \
	  -o $(BUILD_DIR)/flash-serv-tx-packet-test.vvp \
	  cores/usb/rtl/usb_crc.v cores/usb/rtl/usb_tx_pkt.v \
	  cores/usb/rtl/usb_tx_ll.v tests/tb_ulx5m_serv_tx_packet.v
	vvp $(BUILD_DIR)/flash-serv-tx-packet-test.vvp
	python3 tests/check-ulx5m-serv-tx-waveform.py \
	  $(BUILD_DIR)/flash-serv-tx-waveform.csv

# Exercise the real 32-bit CPU-write / 8-bit USB-read endpoint RAM and
# usb_trans-equivalent prefetch strobes through the complete TX packet engine.
# This does not model analog USB pads or microcode endpoint arbitration.
.PHONY: test-flash-serv-epbuf-tx
test-flash-serv-epbuf-tx: | $(BUILD_DIR)
	iverilog -g2012 -Icores/usb/rtl -s tb_ulx5m_serv_epbuf_tx \
	  -o $(BUILD_DIR)/flash-serv-epbuf-tx-test.vvp \
	  cores/usb/rtl/usb_crc.v cores/usb/rtl/usb_ep_buf.v \
	  cores/usb/rtl/usb_tx_pkt.v cores/usb/rtl/usb_tx_ll.v \
	  tests/tb_ulx5m_serv_epbuf_tx.v
	vvp $(BUILD_DIR)/flash-serv-epbuf-tx-test.vvp
	python3 tests/check-ulx5m-serv-epbuf-tx.py \
	  $(BUILD_DIR)/flash-serv-epbuf-tx-waveform.csv

# Execute the full SERV flash-read firmware with register-level USB/UART/SPI mocks.
# This verifies firmware startup and USB attach, NOT USB enumeration or flash IO.
.PHONY: test-flash-serv-firmware
test-flash-serv-firmware: $(SERV_STAMP) $(SERV_SIM_STATE) $(SERV_FW) | $(BUILD_DIR)
	iverilog -g2012 -s tb_ulx5m_serv_firmware_boot -o $(BUILD_DIR)/flash-serv-firmware-test.vvp \
	  $(SERV_SIM_RTL) rtl/soc_serv_cpu.v rtl/soc_bridge.v rtl/soc_bram.v \
	  rtl/soc_mem_response_reg.v tests/tb_ulx5m_serv_firmware_boot.v
	vvp $(BUILD_DIR)/flash-serv-firmware-test.vvp +firmware=$(SERV_FW)

check:
	python3 tests/check-ulx5m-gs-port.py

$(BUILD_DIR):
	mkdir -p $@

$(JSON): $(SRC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog $(SRC); synth_gatemate -top $(TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/synth.log

$(IMPL): $(JSON) $(CCF) $(SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(JSON)) -o ccf=$(abspath $(CCF)) -o out=$(abspath $@) --sdc $(abspath $(SDC)) --router router2 --placer-heap-beta=0.6 -l $(abspath $(BUILD_DIR)/pnr.log)

$(BIT): $(IMPL)
	$(GMPACK) $(abspath $(IMPL)) $(abspath $@)

flash dfu:
	@echo 'ERROR: ULX5M flash and DFU targets are disabled until verified.' >&2
	@exit 1

clean:
	rm -rf $(BUILD_DIR)

# Host-only RAM-DFU staging tests: no synthesis, FPGA programming, or flash.
.PHONY: test-dfu-stage

test-dfu-stage: | $(BUILD_DIR)
	gcc -std=c11 -Wall -Wextra -Werror -Ifw \
	  -o $(BUILD_DIR)/test-dfu-stage \
	  fw/ulx5m_dfu_stage.c tests/test-ulx5m-dfu-stage.c
	$(BUILD_DIR)/test-dfu-stage

# Host firmware-path integration: actual usb_ctrl_ep0.c BD/data/status state
# machine calls the RAM-only DFU receiver. Does not use PHY or flash.
.PHONY: test-dfu-ep0

test-dfu-ep0: | $(BUILD_DIR)
	gcc -std=gnu11 -O1 -g -ffreestanding -fno-builtin \
	  -Wall -Wextra -Werror -DULX5M_EP0_HOST_TEST=1 -DULX5M_SERV_TEST=1 \
	  -Ifw -o $(BUILD_DIR)/test-dfu-ep0 \
	  fw/usb_ctrl_ep0.c fw/ulx5m_dfu_stage.c tests/test-ulx5m-serv-dfu-ep0.c
	$(BUILD_DIR)/test-dfu-ep0

# Host-only discard-only DFU receiver (up to 2 MiB via 64-byte blocks).
.PHONY: test-dfu-stream test-dfu-stream-ep0
test-dfu-stream: | $(BUILD_DIR)
	gcc -std=c11 -Wall -Wextra -Werror -Ifw \
	  -o $(BUILD_DIR)/test-dfu-stream \
	  fw/ulx5m_dfu_stream.c tests/test-ulx5m-dfu-stream.c
	$(BUILD_DIR)/test-dfu-stream

test-dfu-stream-ep0: | $(BUILD_DIR)
	gcc -std=gnu11 -O1 -g -ffreestanding -fno-builtin \
	  -Wall -Wextra -Werror -DULX5M_EP0_HOST_TEST=1 -DULX5M_SERV_TEST=1 \
	  -Ifw -o $(BUILD_DIR)/test-dfu-stream-ep0 \
	  fw/usb_ctrl_ep0.c fw/ulx5m_dfu_stream.c tests/test-ulx5m-serv-dfu-stream-ep0.c
	$(BUILD_DIR)/test-dfu-stream-ep0

# Validate the actual firmware STR1/FLM1 vendor dispatch (host only).
.PHONY: test-dfu-stream-dispatch
test-dfu-stream-dispatch: | $(BUILD_DIR)
	gcc -std=gnu11 -O1 -Wall -Wextra -Werror -ffunction-sections -fdata-sections \
	  -DULX5M_DFU_STREAM_ONLY=1 -Ifw \
	  -Wl,--gc-sections -o $(BUILD_DIR)/test-dfu-stream-dispatch \
	  tests/test-ulx5m-serv-dfu-stream-dispatch.c \
	  fw/ulx5m_flash_layout.c fw/ulx5m_dfu_stream.c
	$(BUILD_DIR)/test-dfu-stream-dispatch

# Host-only provisional flash layout and write-protection policy test.
.PHONY: test-flash-layout

test-flash-layout: | $(BUILD_DIR)
	gcc -std=c11 -Wall -Wextra -Werror -Ifw \
	  -o $(BUILD_DIR)/test-flash-layout \
	  fw/ulx5m_flash_layout.c tests/test-ulx5m-serv-flash-layout.c
	$(BUILD_DIR)/test-flash-layout

# Host-only experimental 0x58 dispatch validation, with dead hardware code removed.
.PHONY: test-flash-layout-ep0

test-flash-layout-ep0: | $(BUILD_DIR)
	gcc -std=gnu11 -O1 -Wall -Wextra -Werror -ffunction-sections -fdata-sections \
	  -DULX5M_DFU_STAGE_ONLY=1 -Ifw \
	  -Wl,--gc-sections -o $(BUILD_DIR)/test-flash-layout-ep0 \
	  tests/test-ulx5m-serv-flash-layout-ep0.c \
	  fw/ulx5m_flash_layout.c fw/ulx5m_dfu_stage.c
	$(BUILD_DIR)/test-flash-layout-ep0
