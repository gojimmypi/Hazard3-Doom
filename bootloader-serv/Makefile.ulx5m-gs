
# Canonical ULX5M-GS SERV + BTN2 USB DFU + autonomous 25 MHz handoff.
# Offline PACK ONLY; no flash/JTAG operations. CI and local use the same build target.
.DEFAULT_GOAL := help

YOSYS ?= yosys
NEXTPNR ?= nextpnr-himbaechel
GMPACK ?= gmpack
IVERILOG ?= iverilog
VVP ?= vvp
PYTHON ?= python3
CC_HOST ?= gcc
SEED ?= 60
# Keep this release equal to the workflow_dispatch OSS CAD Suite defaults.
OSS_CAD_SUITE_VERSION ?= 2026-07-20
EXPECTED_RISCV_GCC_VERSION ?= 12.2.0
HEAP_BETA ?= 0.6
NEXTPNR_EXTRA_ARGS ?=
SERV_DIR ?= third_party/serv
SERV_TAG := 1.4.0
SERV_COMMIT := 7d9cde4
OUT := build-ulx5m-gs
RUN := $(OUT)/bootloader
TOP := top_ulx5m_gs_bootloader
CCF := data/ulx5m-gs.ccf
SDC := data/ulx5m-gs.sdc
MC := $(OUT)/usb_trans_mc.hex
FW := $(RUN)/ulx5m_bootloader.hex
CMD := $(RUN)/cmd.hex
JSON := $(RUN)/$(TOP).json
IMPL := $(RUN)/$(TOP).txt
BIT := $(RUN)/$(TOP)-PACK-ONLY.bit
LOG := $(RUN)/pnr.log
SOURCE := $(RUN)/source.sha256
STAMP := $(RUN)/build.ok
SERV_STAMP := $(OUT)/serv-pinned.stamp
CLI := tests/ulx5m_bootloader.py

MISC_RTL := cores/misc/rtl/uart_wb.v cores/misc/rtl/uart_tx.v \
  cores/misc/rtl/uart_rx.v cores/misc/rtl/uart_irda_tx.v \
  cores/misc/rtl/uart_irda_rx.v cores/misc/rtl/fifo_sync_ram.v \
  cores/misc/rtl/glitch_filter.v cores/misc/rtl/ram_sdp.v \
  cores/misc/rtl/fifo_sync_shift.v
SERV_RTL := $(addprefix $(SERV_DIR)/rtl/, \
  serv_bufreg.v serv_bufreg2.v serv_alu.v serv_csr.v serv_ctrl.v \
  serv_decode.v serv_immdec.v serv_mem_if.v serv_rf_if.v \
  serv_rf_ram_if.v serv_rf_ram.v serv_state.v serv_debug.v \
  serv_top.v serv_rf_top.v serv_aligner.v serv_compdec.v)
SRC := rtl/top_ulx5m_gs_bootloader.v rtl/soc_ulx5m_misc.v \
  rtl/sysmgr_gatemate.v rtl/soc_bridge.v rtl/soc_bram.v \
  rtl/soc_mem_response_reg.v rtl/soc_serv_cpu.v \
  rtl/qspi_master_wb.v rtl/qspi_phy_gatemate.v \
  rtl/ulx5m_btn2_boot_select.v rtl/ulx5m_normal_boot_reset.v \
  rtl/ulx5m_cfg_autoboot_25.v $(MISC_RTL) \
  $(wildcard cores/usb/rtl/*.v) $(SERV_RTL)
FINGERPRINT := $(SRC) $(wildcard cores/usb/rtl/*.vh) \
  $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S fw/lnk-app.lds \
  fw/bin2hex.py fw/Makefile.ulx5m-gs $(FW) $(CMD) $(MC) \
  $(CCF) $(SDC) $(CLI) tests/cfgcmd_codec.py \
  Makefile.ulx5m-gs

.PHONY: help prepare test test-host test-rtl verify-serv synth-check show-settings build qualify clean force-generated
help:
	@echo 'ULX5M-GS: prepare | test | build SEED=60 | qualify SEED=60 | show-settings | clean'
	@echo 'CI routes the SAME full build/qualification as local, not a frozen candidate netlist.'
	@echo 'Local PACK-ONLY; seed sweep and build never access hardware.'

$(OUT) $(RUN):
	@mkdir -p $@

$(MC): cores/usb/utils/microcode.py force-generated | $(OUT)
	$(PYTHON) $< > $@

$(SERV_STAMP): | $(OUT)
	@if ! git -C '$(SERV_DIR)' rev-parse --is-inside-work-tree >/dev/null 2>&1; then \
	  if [ -e '$(SERV_DIR)' ]; then \
	    echo '[FAIL] Existing SERV_DIR is not a Git checkout' >&2; exit 1; \
	  fi; \
	  mkdir -p '$(dir $(SERV_DIR))'; \
	  git clone --quiet --depth 1 --branch '$(SERV_TAG)' \
	    https://github.com/olofk/serv.git '$(SERV_DIR)' || exit 1; \
	fi
	@rev=$$(git -C '$(SERV_DIR)' rev-parse --short=7 HEAD) || exit 1; \
	  if [ "$$rev" != '$(SERV_COMMIT)' ]; then \
	    echo "[FAIL] Expected SERV $(SERV_COMMIT), got $$rev" >&2; exit 1; \
	  fi
	@test -f '$(SERV_DIR)/rtl/serv_rf_top.v'
	@touch '$@'

$(SERV_RTL): $(SERV_STAMP)
	@test -f '$@' || { echo '[FAIL] Missing SERV source $@' >&2; exit 1; }

verify-serv: $(SERV_STAMP)
	@rev=$$(git -C '$(SERV_DIR)' rev-parse --short=7 HEAD) || exit 1; \
	  if [ "$$rev" != '$(SERV_COMMIT)' ]; then \
	    echo "[FAIL] SERV revision changed: $$rev (expected $(SERV_COMMIT))" >&2; exit 1; \
	  fi

$(FW): $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S \
  fw/lnk-app.lds fw/bin2hex.py fw/Makefile.ulx5m-gs force-generated | $(RUN)
	$(MAKE) -B -C fw -f Makefile.ulx5m-gs all BUILD_DIR=../$(RUN) EXPECTED_GCC_VERSION=$(EXPECTED_RISCV_GCC_VERSION)

force-generated:

$(CMD): $(CLI) | $(RUN)
	$(PYTHON) $(CLI) bootstrap --output $@

prepare: $(CMD) $(MC)

# Host tests exercise flash boundaries and native DFU chains without any
# physical flash accesses or target programming.
test-host: | $(OUT)
	$(CC_HOST) -std=c11 -Wall -Wextra -Werror -Ifw \
	  -o $(OUT)/test-at25-protected fw/ulx5m_at25ql321.c \
	  tests/test-ulx5m-serv-at25ql321-protected.c
	$(OUT)/test-at25-protected
	$(CC_HOST) -std=c11 -Wall -Wextra -Werror -Ifw \
	  -o $(OUT)/test-program-protected fw/ulx5m_flash_program.c fw/ulx5m_flash_layout.c \
	  tests/test-ulx5m-serv-flash-program-protected.c
	$(OUT)/test-program-protected
	$(CC_HOST) -std=c11 -Wall -Wextra -Werror -O1 \
	  -DULX5M_AT25QL321_EMULATOR_TEST=1 -Ifw -Itests \
	  -o $(OUT)/test-at25-emulator fw/ulx5m_at25ql321.c \
	  tests/ulx5m-at25ql321-mock.c tests/test-ulx5m-serv-at25ql321.c
	$(OUT)/test-at25-emulator
	$(CC_HOST) -std=c11 -Wall -Wextra -Werror -O1 \
	  -DULX5M_AT25QL321_EMULATOR_TEST=1 \
	  -DULX5M_FLASH_PROGRAM_EMULATOR_TEST=1 \
	  -DULX5M_DFU_STREAM_EMULATOR_TEST=1 -Ifw -Itests \
	  -o $(OUT)/test-dfu-flash-chain fw/ulx5m_at25ql321.c \
	  fw/ulx5m_flash_program.c fw/ulx5m_dfu_stream.c \
	  tests/ulx5m-at25ql321-mock.c tests/test-ulx5m-serv-at25ql321-chain.c
	$(OUT)/test-dfu-flash-chain
	$(CC_HOST) -std=c11 -Wall -Wextra -Werror -O1 \
	  -DULX5M_AT25QL321_EMULATOR_TEST=1 \
	  -DULX5M_FLASH_PROGRAM_EMULATOR_TEST=1 \
	  -DULX5M_DFU_STREAM_EMULATOR_TEST=1 \
	  -DULX5M_DFU_FULL_IMAGE_TEST=1 -Ifw -Itests \
	  -o $(OUT)/test-dfu-full-image fw/ulx5m_at25ql321.c \
	  fw/ulx5m_flash_program.c fw/ulx5m_dfu_stream.c \
	  tests/ulx5m-at25ql321-mock.c tests/test-ulx5m-serv-at25ql321-chain.c
	$(OUT)/test-dfu-full-image

	$(CC_HOST) -std=c11 -Wall -Wextra -Werror -O1 \
	  -DULX5M_AT25QL321_EMULATOR_TEST=1 \
	  -DULX5M_FLASH_HW_TEST=1 -DULX5M_FLASH_HW_HOST_TEST=1 \
	  -DULX5M_DFU_HW_TEST_ONLY=1 -DULX5M_DFU_FULL_IMAGE_TEST=1 -Ifw -Itests \
	  -o $(OUT)/test-dfu-full-vendor fw/ulx5m_at25ql321.c \
	  fw/ulx5m_flash_program.c fw/ulx5m_flash_layout.c \
	  fw/ulx5m_dfu_stream.c fw/ulx5m_flash_hw_test.c \
	  tests/ulx5m-at25ql321-mock.c tests/test-ulx5m-serv-at25ql321-chain.c
	$(OUT)/test-dfu-full-vendor

test-rtl: prepare
	@command -v '$(IVERILOG)' >/dev/null || { echo '[FAIL] iverilog required' >&2; exit 1; }
	@command -v '$(VVP)' >/dev/null || { echo '[FAIL] vvp required' >&2; exit 1; }
	$(IVERILOG) -g2012 -s tb_ulx5m_cfg_autoboot_25 -o $(OUT)/cfg25.vvp \
	  rtl/ulx5m_cfg_autoboot_25.v tests/tb_ulx5m_cfg_autoboot_25.v
	$(VVP) $(OUT)/cfg25.vvp
	$(IVERILOG) -g2012 -s tb_ulx5m_btn2_boot_select -o $(OUT)/btn2.vvp \
	  rtl/ulx5m_btn2_boot_select.v tests/tb_ulx5m_btn2_boot_select.v
	$(VVP) $(OUT)/btn2.vvp
	$(IVERILOG) -g2012 -s tb_ulx5m_normal_boot_reset -o $(OUT)/reset.vvp \
	  rtl/ulx5m_normal_boot_reset.v tests/tb_ulx5m_normal_boot_reset.v
	$(VVP) $(OUT)/reset.vvp

test: prepare test-host test-rtl
	$(PYTHON) tests/test_ulx5m_bootloader.py

# Offline synthesis smoke check. The resulting netlist is NOT a boot image.
# GitHub seed sweep never routes this preliminary artifact.
synth-check: verify-serv $(SERV_RTL) $(MC) $(FW) $(CMD) | $(RUN)
	@command -v '$(YOSYS)' >/dev/null || { echo '[FAIL] yosys required' >&2; exit 1; }
	$(PYTHON) $(CLI) bootstrap --output $(CMD)
	$(YOSYS) -p 'read_verilog -defer -Icores/usb/rtl $(SRC); synth_gatemate -top $(TOP) -luttree -nomx8 -json $(abspath $(JSON))' > $(RUN)/synth.log
	@test -s '$(JSON)' || { echo '[FAIL] frozen netlist missing' >&2; exit 1; }
	@echo '[PASS] offline synthesis smoke check; NOT a qualified boot image'

# Print the shared defaults that CI uses when no advanced overrides are selected.
show-settings:
	@echo 'OSS_CAD_SUITE_VERSION=$(OSS_CAD_SUITE_VERSION)'
	@echo 'EXPECTED_RISCV_GCC_VERSION=$(EXPECTED_RISCV_GCC_VERSION)'
	@echo 'SEED=$(SEED)'
	@echo 'HEAP_BETA=$(HEAP_BETA)'
	@echo 'NEXTPNR_EXTRA_ARGS=$(NEXTPNR_EXTRA_ARGS)'
	@echo 'YOSYS=$(YOSYS)'
	@echo 'NEXTPNR=$(NEXTPNR)'
	@echo 'GMPACK=$(GMPACK)'

# The embedded handoff command is derived from the actual packed image.
# Repack deterministically until it agrees or fail closed. A failed route
# cannot leave behind a stale, apparently qualified bitstream.
build: test verify-serv $(SERV_RTL) $(MC) $(FW)
	@set -eu; \
	  for tool in '$(YOSYS)' '$(NEXTPNR)' '$(GMPACK)'; do \
	    command -v "$$tool" >/dev/null || { echo "[FAIL] Missing $$tool" >&2; exit 1; }; \
	  done; \
	  rm -f -- $(BIT) $(IMPL) $(LOG) $(SOURCE) $(STAMP); \
	  echo '[INPUT] $(SEED): OSS_CAD_SUITE_VERSION=$(OSS_CAD_SUITE_VERSION) HEAP_BETA=$(HEAP_BETA) NEXTPNR_EXTRA_ARGS=$(NEXTPNR_EXTRA_ARGS)'; \
	  $(YOSYS) --version; $(NEXTPNR) --version; \
	  sha256sum $(FW) $(MC) $(CCF) $(SDC); \
	  $(PYTHON) $(CLI) bootstrap --output $(CMD); \
	  for pass in 1 2 3; do \
	    echo "[INFO] Packing pass $$pass, seed $(SEED)"; \
	    $(YOSYS) -p 'read_verilog -defer -Icores/usb/rtl $(SRC); synth_gatemate -top $(TOP) -luttree -nomx8 -json $(abspath $(JSON))' > $(RUN)/synth.log; \
	    echo "[INPUT] pass $$pass, seed $(SEED):"; sha256sum $(CMD) $(JSON); \
	    $(NEXTPNR) --device CCGM1A1 --json $(abspath $(JSON)) \
	      -o ccf=$(abspath $(CCF)) -o out=$(abspath $(IMPL)) \
	      --sdc $(abspath $(SDC)) --router router2 \
	      --placer-heap-beta=$(HEAP_BETA) $(NEXTPNR_EXTRA_ARGS) --seed $(SEED) -l $(abspath $(LOG)); \
	    $(GMPACK) --reconfig --bootaddr 2101248 \
	      $(abspath $(IMPL)) $(abspath $(BIT)); \
	    if $(PYTHON) $(CLI) derive --bit $(BIT) --hex $(CMD) --check; then \
	      $(PYTHON) $(CLI) fingerprint --output $(SOURCE) --inputs $(FINGERPRINT); \
	      $(PYTHON) $(CLI) stamp --bit $(BIT) --output $(STAMP) --seed $(SEED); \
	      echo '[PASS] Image-derived ROM matches packed primary'; exit 0; \
	    fi; \
	    $(PYTHON) $(CLI) derive --bit $(BIT) --hex $(CMD) --write; \
	  done; \
	  rm -f -- $(BIT) $(SOURCE) $(STAMP); \
	  echo '[FAIL] Image-derived command did not converge in 3 passes' >&2; exit 1

# Explicit, separate and repeatable verification of the completed build.
qualify:
	$(PYTHON) $(CLI) qualify --bit $(BIT) --hex $(CMD) \
	  --json $(JSON) --pnr-log $(LOG) --source-sha $(SOURCE) \
	  --stamp $(STAMP) --seed $(SEED) --inputs $(FINGERPRINT)

clean:
	@case '$(OUT)' in build-ulx5m-gs) rm -rf -- '$(OUT)' ;; \
	  *) echo '[FAIL] refusing to remove unexpected build dir' >&2; exit 1 ;; esac
