# v72 offline only: source-derived ROM, local PNR/pack, no JTAG or flash writes.
.DEFAULT_GOAL := help
YOSYS ?= yosys
NEXTPNR ?= nextpnr-himbaechel
GMPACK ?= gmpack
V72_SEED ?= 302
V72_DIR := build-ulx5m-gs/v72-registered-probe
V72_TOP := top_ulx5m_gs_v72_cfg_registered_probe
V72_SRC := rtl/top-ulx5m-gs-v72-cfg-registered-probe.v
V72_CCF := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.ccf
V72_SDC := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.sdc
V72_CMD := $(V72_DIR)/cmd.hex
V72_JSON := $(V72_DIR)/$(V72_TOP).json
V72_SOURCE_SHA := $(V72_DIR)/source.sha256
V72_IMPL := $(V72_DIR)/$(V72_TOP)-seed$(V72_SEED).txt
V72_BIT := $(V72_DIR)/$(V72_TOP)-seed$(V72_SEED)-PACK-ONLY.bit
V70_BIT := build-ulx5m-gs/v70-runtime-clear/top_ulx5m_gs_v70_cfg_runtime_clear_probe-seed302-PACK-ONLY.bit
V72_GENERATOR := tests/mk-ulx5m-v72-cmd.py

.PHONY: help v72-prepare v72-test v72-build v72-qualify
help:
	@echo 'v72 experimental minimal probe; offline only; NEVER FLASH THIS BITFILE.'
	@echo 'make -f Makefile.ulx5m-v72-cfg-registered-probe v72-prepare'
	@echo 'make -f Makefile.ulx5m-v72-cfg-registered-probe v72-test'
	@echo 'make -f Makefile.ulx5m-v72-cfg-registered-probe v72-build'
	@echo 'make -f Makefile.ulx5m-v72-cfg-registered-probe v72-qualify'

v72-prepare:
	python3 $(V72_GENERATOR) --bit $(V70_BIT) --hex $(V72_CMD) --write --bootstrap-v70

v72-test:
	@command -v iverilog >/dev/null 2>&1 || { echo "[FAIL] iverilog unavailable; RTL simulation is mandatory"; exit 1; }
	@command -v vvp >/dev/null 2>&1 || { echo "[FAIL] vvp unavailable; RTL simulation is mandatory"; exit 1; }
	python3 tests/test-ulx5m-v72-cfg-registered.py

# Build is deliberately forced instead of using timestamp-only cached outputs.
# Start with the pinned v70 image, then re-derive from the new final packed
# image until ROM and status reach an exact fixed point (maximum three passes).
# This is the same bounded two-pass principle used by upstream TinyDFU.
v72-build: v72-prepare v72-test
	@set -eu; \
	bash ../scripts/check-ulx5m-oss-cad-suite.sh; \
	mkdir -p $(V72_DIR); \
	python3 $(V72_GENERATOR) --bit $(V70_BIT) --hex $(V72_CMD) --write --bootstrap-v70; \
	for pass in 1 2 3; do \
	    echo "[INFO] v72 source-derived local build pass $$pass"; \
    sha256sum $(V72_SRC) > $(V72_SOURCE_SHA); \
	    $(YOSYS) -p 'read_verilog -defer $(V72_SRC); synth_gatemate -top $(V72_TOP) -luttree -nomx8 -json $(abspath $(V72_JSON))' > $(V72_DIR)/synth.log; \
	    $(NEXTPNR) --device CCGM1A1 --json $(abspath $(V72_JSON)) -o ccf=$(abspath $(V72_CCF)) -o out=$(abspath $(V72_IMPL)) --sdc $(abspath $(V72_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(V72_SEED) -l $(abspath $(V72_DIR)/pnr-seed$(V72_SEED).log); \
	    $(GMPACK) --reconfig --bootaddr 2101248 $(abspath $(V72_IMPL)) $(abspath $(V72_BIT)); \
	    if python3 $(V72_GENERATOR) --bit $(V72_BIT) --hex $(V72_CMD) --check; then \
	        echo '[PASS] ROM matches final v72 bitstream'; exit 0; \
	    fi; \
	    python3 $(V72_GENERATOR) --bit $(V72_BIT) --hex $(V72_CMD) --write; \
	done; \
	echo '[FAIL] No self-consistent ROM/bitstream after three passes'; exit 1

v72-qualify: v72-test
	python3 tests/qualify-ulx5m-v72-cfg-registered.py --bit $(V72_BIT) --pnr-log $(V72_DIR)/pnr-seed$(V72_SEED).log --hex $(V72_CMD) --json $(V72_JSON) --source-sha $(V72_SOURCE_SHA)
