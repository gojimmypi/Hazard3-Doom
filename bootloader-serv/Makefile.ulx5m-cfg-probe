# ULX5M-GS VOLATILE self-reconfiguration capability probe.
# Does not program SPI flash, require a running bootloader, or replace
# any of the known-good normal-boot build targets. Hardware is OPT-IN.
# Invoke from bootloader-serv directory.
SHELL := /bin/sh
# Default remains the hardware-tested v26 probe. The alternative is isolated.
CFG_DEST ?= default
ifeq ($(CFG_DEST),default)
BUILD := build-ulx5m-gs/cfg-probe
ROM_DEFINES :=
else ifeq ($(CFG_DEST),reconfig)
BUILD := build-ulx5m-gs/cfg-probe-dest-reconfig
ROM_DEFINES := -DULX5M_CFG_PROBE_DEST_RECONFIG
else ifeq ($(CFG_DEST),reset_reconfig)
BUILD := build-ulx5m-gs/cfg-probe-dest-reset-reconfig
ROM_DEFINES := -DULX5M_CFG_PROBE_DEST_RESET_RECONFIG
else
$(error CFG_DEST must be default, reconfig or reset_reconfig)
endif
TOP := top_ulx5m_gs_cfg_probe
SRC := rtl/top-ulx5m-gs-cfg-probe.v
LED := build-ulx5m-gs/top_ulx5m_gs_normal_led.bit
ifeq ($(CFG_DEST),reconfig)
ROM := $(BUILD)/walking-led-reconfig.hex
DEST_BIT := $(BUILD)/walking-led-reconfig.bit
LED_IMPL := build-ulx5m-gs/top_ulx5m_gs_normal_led.txt
else ifeq ($(CFG_DEST),reset_reconfig)
ROM := $(BUILD)/walking-led-reset-reconfig.hex
DEST_BIT := $(BUILD)/walking-led-reset-reconfig.bit
LED_IMPL := build-ulx5m-gs/top_ulx5m_gs_normal_led.txt
else
ROM := $(BUILD)/walking-led.hex
endif
CCF := data/top-ulx5m-gs-cfg-probe.ccf
SDC := data/top-ulx5m-gs-cfg-probe.sdc
JSON := $(BUILD)/$(TOP).json
IMPL := $(BUILD)/$(TOP).txt
BIT := $(BUILD)/$(TOP).bit
SIM := $(BUILD)/cfg-probe.vvp
SEED ?= 122

.PHONY: test bit

$(BUILD):
	mkdir -p $@

ifeq ($(CFG_DEST),reconfig)
$(ROM): $(LED) $(LED_IMPL) tests/prepare-ulx5m-cfg-probe-reconfig-rom.py | $(BUILD)
	python3 tests/prepare-ulx5m-cfg-probe-reconfig-rom.py --image $(LED) --implementation $(LED_IMPL) --rom $@ --bit $(DEST_BIT)
else ifeq ($(CFG_DEST),reset_reconfig)
$(ROM): $(LED) $(LED_IMPL) tests/prepare-ulx5m-cfg-probe-reset-reconfig-rom.py | $(BUILD)
	python3 tests/prepare-ulx5m-cfg-probe-reset-reconfig-rom.py --image $(LED) --implementation $(LED_IMPL) --rom $@ --bit $(DEST_BIT)
else
$(ROM): $(LED) tests/prepare-ulx5m-cfg-probe-rom.py | $(BUILD)
	python3 tests/prepare-ulx5m-cfg-probe-rom.py --image $(LED) --rom $@
endif

$(SIM): $(SRC) tests/tb_ulx5m_cfg_probe.v $(ROM)
	iverilog -g2012 $(ROM_DEFINES) -s tb_ulx5m_cfg_probe -o $@ $(SRC) tests/tb_ulx5m_cfg_probe.v

test: $(SIM)
	vvp $(SIM)

$(JSON): $(SRC) $(ROM) | $(BUILD)
	yosys -p 'read_verilog -defer $(ROM_DEFINES) $(SRC); synth_gatemate -top $(TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD)/synth.log

$(IMPL): $(JSON) $(CCF) $(SDC)
	nextpnr-himbaechel --device CCGM1A1 --json $(abspath $(JSON)) -o ccf=$(abspath $(CCF)) -o out=$(abspath $@) --sdc $(abspath $(SDC)) --router router2 --placer-heap-beta=0.6 --seed $(SEED) -l $(abspath $(BUILD)/pnr.log)

$(BIT): $(IMPL)
	gmpack --reconfig $(abspath $(IMPL)) $(abspath $@)

bit: $(BIT)
	sha256sum $(BIT)
