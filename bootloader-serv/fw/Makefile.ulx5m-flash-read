# Read-only ULX5M flash diagnostic; separate from USB probe and DFU firmware.
# Use a toolchain from PATH, a local xPack installation, or CROSS= explicitly.
# Paths are relative to bootloader-serv/fw (make is invoked with -C fw).
RISCV_PATH_CROSS := $(shell for p in riscv-none-elf- riscv32-unknown-elf- riscv64-unknown-elf- riscv-none-embed-; do \
    if command -v "$${p}gcc" >/dev/null 2>&1; then printf '%s' "$$p"; break; fi; \
    done)
RISCV_LOCAL_GCC := $(firstword \
    $(wildcard $(HOME)/.local/xPacks/@xpack-dev-tools/riscv-none-elf-gcc/*/.content/bin/riscv-none-elf-gcc) \
    $(wildcard $(HOME)/.local/xPacks/riscv-none-elf-gcc/*/.content/bin/riscv-none-elf-gcc) \
    $(wildcard ../../bin/riscv-gcc/bin/riscv-none-elf-gcc) \
    $(wildcard ../../bin/riscv-gcc/*/bin/riscv-none-elf-gcc) \
    $(wildcard /opt/riscv/bin/riscv32-unknown-elf-gcc) \
    $(wildcard /opt/riscv/bin/riscv-none-elf-gcc))
RISCV_LOCAL_CROSS := $(patsubst %gcc,%,$(RISCV_LOCAL_GCC))
CROSS ?= $(or $(RISCV_PATH_CROSS),$(RISCV_LOCAL_CROSS),riscv-none-elf-)
CC := $(CROSS)gcc
OBJCOPY := $(CROSS)objcopy
BUILD_DIR ?= ../build-ulx5m-gs

CFLAGS := -DBOARD_ULX5M_GS=1 -Wall -Wextra -Os -march=rv32i -mabi=ilp32 \
  -ffreestanding -fno-builtin -fno-pic -fomit-frame-pointer \
  -ffunction-sections -fdata-sections -nostartfiles
LDFLAGS := -Wl,-Bstatic,-T,lnk-app.lds,--gc-sections

# SERV uses the same RV32I firmware but needs an explicit stack pointer.
ifeq ($(SERV),1)
CFLAGS += -DULX5M_SERV_TEST=1
endif

SRCS := start.S fw_ulx5m_flash_read.c usb_desc_ulx5m_probe.c \
  usb.c usb_ctrl_ep0.c usb_ctrl_std.c console.c mini-printf.c

# Opt-in RAM-only DFU receiver. Use a SEPARATE BUILD_DIR for this profile.
ifeq ($(DFU_STAGE_ONLY),1)
ifeq ($(findstring dfu-stage,$(BUILD_DIR)),)
$(error DFU_STAGE_ONLY requires separate BUILD_DIR containing dfu-stage)
endif
CFLAGS += -DULX5M_DFU_STAGE_ONLY=1
SRCS += ulx5m_dfu_stage.c ulx5m_flash_layout.c
endif

# Hardware-write permission must never appear in legacy/normal firmware.
ifeq ($(DFU_HW_TEST_ONLY),1)
ifneq ($(DFU_STREAM_ONLY),1)
$(error DFU_HW_TEST_ONLY requires DFU_STREAM_ONLY=1)
endif
endif
ifeq ($(DFU_HW_MULTI_TEST_ONLY),1)
ifneq ($(DFU_HW_TEST_ONLY),1)
$(error DFU_HW_MULTI_TEST_ONLY requires DFU_HW_TEST_ONLY=1)
endif
ifeq ($(findstring dfu-hw-multi,$(BUILD_DIR)),)
$(error DFU_HW_MULTI_TEST_ONLY requires an isolated dfu-hw-multi BUILD_DIR)
endif
endif

# Separate discard-only DFU streaming profile: no image retention or writes.
ifeq ($(DFU_STREAM_ONLY),1)
ifneq ($(DFU_STAGE_ONLY),)
$(error DFU_STREAM_ONLY cannot be combined with DFU_STAGE_ONLY)
endif
ifeq ($(findstring dfu-stream,$(BUILD_DIR))$(findstring dfu-hw-test,$(BUILD_DIR))$(findstring dfu-hw-multi,$(BUILD_DIR)),)
$(error DFU_STREAM_ONLY requires separate dfu-stream or dfu-hw-test BUILD_DIR)
endif
CFLAGS += -DULX5M_DFU_STREAM_ONLY=1
SRCS += ulx5m_dfu_stream.c ulx5m_flash_layout.c \
  ulx5m_at25ql321.c ulx5m_at25ql321_hw.c
ifeq ($(DFU_HW_TEST_ONLY),1)
ifeq ($(findstring dfu-hw-test,$(BUILD_DIR))$(findstring dfu-hw-multi,$(BUILD_DIR)),)
$(error DFU_HW_TEST_ONLY requires an isolated dfu-hw-test or dfu-hw-multi BUILD_DIR)
endif
CFLAGS += -DULX5M_FLASH_HW_TEST=1 -DULX5M_DFU_HW_TEST_ONLY=1
ifeq ($(DFU_HW_MULTI_TEST_ONLY),1)
CFLAGS += -DULX5M_FLASH_HW_MULTI_TEST=1 -DULX5M_DFU_HW_MULTI_TEST_ONLY=1
endif
SRCS += ulx5m_flash_program.c ulx5m_flash_hw_test.c
endif
endif

.DEFAULT_GOAL := all
.PHONY: all check-toolchain
all: $(BUILD_DIR)/fw_ulx5m_flash_read.hex

$(BUILD_DIR):
	mkdir -p $@

check-toolchain:
	@command -v '$(CC)' >/dev/null 2>&1 || { \
		echo "ERROR: RISC-V GCC not found: $(CC)" >&2; \
		echo 'Set CROSS=/path/to/bin/riscv-none-elf- or add xPack bin to PATH.' >&2; \
		exit 1; \
	}
	@command -v '$(OBJCOPY)' >/dev/null 2>&1 || { \
		echo "ERROR: RISC-V objcopy not found: $(OBJCOPY)" >&2; \
		exit 1; \
	}

$(BUILD_DIR)/fw_ulx5m_flash_read.elf: $(SRCS) lnk-app.lds Makefile.ulx5m-gs | $(BUILD_DIR) check-toolchain
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(SRCS)
ifeq ($(DFU_STAGE_ONLY),1)
	$(CROSS)nm -n $@ > $(BUILD_DIR)/dfu-stage-symbols.txt
	python3 ../tests/check-ulx5m-serv-dfu-ram.py $(BUILD_DIR)/dfu-stage-symbols.txt
endif

$(BUILD_DIR)/fw_ulx5m_flash_read.bin: $(BUILD_DIR)/fw_ulx5m_flash_read.elf
	$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/fw_ulx5m_flash_read.hex: $(BUILD_DIR)/fw_ulx5m_flash_read.bin bin2hex.py
	python3 bin2hex.py $< $@
