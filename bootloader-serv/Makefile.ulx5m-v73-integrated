# v73 isolated 48 MHz SERV + BTN2 DFU + registered secondary handoff.
# ALL targets are OFFLINE. No JTAG programmer, DFU writer, or flash action.
# Full-SERV ROM seed is derived from the archived v63c packed-image status.
# No initial small-probe v72 ROM is used for timing sweeps.
include Makefile.ulx5m-gs
.DEFAULT_GOAL := v73-help

V73_SEED ?= 122
V73_DIR := build-ulx5m-gs/v73-normal-boot-dfu-hw-native
V73_TOP := top_ulx5m_gs_flash_read
V73_SRC := $(filter-out rtl/ulx5m_cfg_stream_wb.v,$(NORMAL_BOOT_SRC)) rtl/ulx5m_spi_active_reboot_wb.v
V73_FW := $(V73_DIR)/fw_ulx5m_flash_read.hex
V73_CMD := $(V73_DIR)/cmd.hex
V73_JSON := $(V73_DIR)/$(V73_TOP).json
V73_IMPL := $(V73_DIR)/$(V73_TOP)-seed$(V73_SEED).txt
V73_BIT := $(V73_DIR)/$(V73_TOP)-seed$(V73_SEED)-PACK-ONLY.bit
V73_LOG := $(V73_DIR)/pnr-seed$(V73_SEED).log
V73_SOURCE := $(V73_DIR)/source.sha256
V73_DEFINES := -DULX5M_USE_SERV -DULX5M_SERV_DFU_STREAM \
  -DULX5M_SERV_BTN2_DFU_GATE -DULX5M_SERV_NORMAL_BOOT_EXPERIMENT \
  -DULX5M_SERV_SPI_ACTIVE_SECONDARY -DULX5M_SERV_DFU_HW_NATIVE_TEST \
  -DULX5M_V73_REGISTERED_REBOOT -DULX5M_V76_HW_NORMAL_BOOT \
  -DULX5M_V78_V72_STARTUP_DELAY

.PHONY: v73-help v73-prepare v73-test v73-build v73-qualify
v73-help:
	@echo 'v73 integrated SERV+DFU registered reconfiguration; offline PACK ONLY.'
	@echo 'make -f Makefile.ulx5m-v73-integrated v73-prepare'
	@echo 'make -f Makefile.ulx5m-v73-integrated v73-test'
	@echo 'make -f Makefile.ulx5m-v73-integrated v73-build'
	@echo 'make -f Makefile.ulx5m-v73-integrated v73-qualify'

v73-prepare:
	@mkdir -p $(V73_DIR)
	python3 tests/v73-gh-bootstrap-rom.py --output $(V73_CMD)
	python3 tests/v73-gh-bootstrap-rom.py --output $(V73_CMD) --check

v73-test:
	@test -f $(V73_CMD) || { echo '[FAIL] Run v73-prepare first: missing command ROM'; exit 1; }
	@command -v iverilog >/dev/null 2>&1 || { echo '[FAIL] iverilog mandatory for v73'; exit 1; }
	@command -v vvp >/dev/null 2>&1 || { echo '[FAIL] vvp mandatory for v73'; exit 1; }
	python3 tests/test-ulx5m-v73-integrated.py

# Complete isolated source-derived build: no dependence on cached v63c HEX.
# Compute fixed point between packed v73 image and the ROM held in its BRAM.
# All synthesis, PNR and packaging is local; NEVER FLASH this output.
v73-build: v73-prepare v73-test $(SERV_STAMP) $(SERV_RTL) $(PROBE_MC)
	@set -eu; \
	bash ../scripts/check-ulx5m-oss-cad-suite.sh; \
	test -s $(PROBE_MC) || { echo "[FAIL] Missing or empty USB transaction microcode: $(PROBE_MC)"; exit 1; }; \
	$(MAKE) -C fw -f Makefile.ulx5m-flash-read -B all \
	    BUILD_DIR=../$(V73_DIR) SERV=1 NORMAL_BOOT_EXPERIMENT=1 \
	    DFU_STREAM_ONLY=1 DFU_HW_TEST_ONLY=1 DFU_HW_NATIVE_TEST_ONLY=1 \
	    NATIVE_SPI_SECONDARY=1; \
	for pass in 1 2 3; do \
	    echo "[INFO] v73 combined local build pass $$pass, seed $(V73_SEED)"; \
	    sha256sum rtl/ulx5m_spi_active_reboot_wb.v \
	        rtl/top-ulx5m-gs-flash-read.v $(V73_FW) \
	        Makefile.ulx5m-v73-integrated > $(V73_SOURCE); \
	    $(YOSYS) -p 'read_verilog -defer $(V73_DEFINES) -Icores/usb/rtl $(V73_SRC); synth_gatemate -top $(V73_TOP) -luttree -nomx8 -json $(abspath $(V73_JSON))' > $(V73_DIR)/synth.log; \
	    $(NEXTPNR) --device CCGM1A1 --json $(abspath $(V73_JSON)) \
	        -o ccf=$(abspath $(FLASH_CCF)) -o out=$(abspath $(V73_IMPL)) \
	        --sdc $(abspath $(FLASH_SDC)) --router router2 \
	        --placer-heap-beta=0.6 --seed $(V73_SEED) -l $(abspath $(V73_LOG)); \
	    $(GMPACK) --reconfig --bootaddr 2101248 $(abspath $(V73_IMPL)) $(abspath $(V73_BIT)); \
	    if python3 tests/mk-ulx5m-v72-cmd.py --bit $(V73_BIT) --hex $(V73_CMD) --check; then \
	        echo '[PASS] v73 command matches final packed v73 primary'; exit 0; \
	    fi; \
	    python3 tests/mk-ulx5m-v72-cmd.py --bit $(V73_BIT) --hex $(V73_CMD) --write; \
	done; \
	echo '[FAIL] v73 ROM did not converge after three passes'; exit 1

v73-qualify: v73-test
	python3 tests/qualify-ulx5m-v73-integrated.py \
	  --bit $(V73_BIT) --hex $(V73_CMD) --json $(V73_JSON) \
	  --pnr-log $(V73_LOG) --source-sha $(V73_SOURCE)
