# ULX5M-GS v68: ONLY local synthesis/route/pack + offline qualification.
# Reuses vetted v66 pin constraints and v63b timing helper. NEVER programs flash.
.DEFAULT_GOAL := help
YOSYS ?= yosys
NEXTPNR ?= nextpnr-himbaechel
GMPACK ?= gmpack
DEVICE ?= CCGM1A1
V68_SEED ?= 302
V68_BASE := build-ulx5m-gs/v68-runtime-clear
V68_TOP := top_ulx5m_gs_v68_cfg_runtime_clear_probe
V68_SRC := rtl/top-ulx5m-gs-v68-cfg-runtime-clear-probe.v
V68_STREAM := rtl/ulx5m_cfg_bank_command_stream.v
V68_CCF := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.ccf
V68_SDC := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.sdc
V68_JSON := $(V68_BASE)/$(V68_TOP).json
V68_IMPL := $(V68_BASE)/$(V68_TOP)-seed$(V68_SEED).txt
V68_BIT := $(V68_BASE)/$(V68_TOP)-seed$(V68_SEED)-PACK-ONLY.bit
.DELETE_ON_ERROR: $(V68_IMPL) $(V68_BIT)
.PHONY: help v68-build v68-test
help:
	@echo 'EXPERIMENTAL v68. No JTAG or flash programming target.'
	@echo 'make -f Makefile.ulx5m-v68-cfg-runtime-clear-probe v68-test'
	@echo 'make -f Makefile.ulx5m-v68-cfg-runtime-clear-probe v68-build'
v68-test:
	python3 tests/test-ulx5m-v68-cfg-runtime-clear.py
v68-build: $(V68_BIT)
$(V68_BASE):
	mkdir -p $@
$(V68_JSON): $(V68_SRC) $(V68_STREAM) $(V68_CCF) $(V68_SDC) | $(V68_BASE)
	$(YOSYS) -p 'read_verilog -defer $(V68_STREAM) $(V68_SRC); synth_gatemate -top $(V68_TOP) -luttree -nomx8 -json $(abspath $@)' > $(V68_BASE)/synth.log
$(V68_IMPL): $(V68_JSON) $(V68_CCF) $(V68_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(V68_JSON)) -o ccf=$(abspath $(V68_CCF)) -o out=$(abspath $@) --sdc $(abspath $(V68_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(V68_SEED) -l $(abspath $(V68_BASE)/pnr-seed$(V68_SEED).log)
$(V68_BIT): $(V68_IMPL)
	$(GMPACK) --reconfig --bootaddr 2101248 $(abspath $<) $(abspath $@)
	python3 tests/qualify-ulx5m-v68-cfg-runtime-clear.py $(abspath $@) --pnr-log $(abspath $(V68_BASE)/pnr-seed$(V68_SEED).log)
