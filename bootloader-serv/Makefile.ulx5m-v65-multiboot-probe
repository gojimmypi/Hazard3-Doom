# ULX5M-GS v65: OFFLINE/LOCAL-BUILD-ONLY Peppercorn 128 replication.
# Does not include other Makefiles, any programmer target or flash writer.
# v65 primary is NOT DFU capable. Keep the v64 recovery session immutable.
.DEFAULT_GOAL := help
YOSYS ?= yosys
NEXTPNR ?= nextpnr-himbaechel
GMPACK ?= gmpack
DEVICE ?= CCGM1A1
V65_SEED ?= 302
V65_BASE := build-ulx5m-gs/v65-minimal-multiboot
V65_TOP := top_ulx5m_gs_v65_multiboot_probe
V65_SRC := rtl/top-ulx5m-gs-v65-multiboot-probe.v
V65_CCF := data/top-ulx5m-gs-v65-multiboot-probe.ccf
V65_SDC := data/top-ulx5m-gs-v65-multiboot-probe.sdc
V65_JSON := $(V65_BASE)/$(V65_TOP).json
V65_IMPL := $(V65_BASE)/$(V65_TOP)-seed$(V65_SEED).txt
V65_BIT := $(V65_BASE)/$(V65_TOP)-seed$(V65_SEED)-PACK-ONLY.bit
V65_BOOTADDR := 2101248
.DELETE_ON_ERROR: $(V65_IMPL) $(V65_BIT)
.PHONY: help v65-build v65-test
help:
	@echo 'v65: make -f Makefile.ulx5m-v65-multiboot-probe v65-test'
	@echo 'v65: make -f Makefile.ulx5m-v65-multiboot-probe v65-build'
	@echo 'Creates ONLY an offline primary bitstream; NO flash/program commands.'
v65-test:
	python3 tests/test-ulx5m-v65-multiboot-probe.py
v65-build: $(V65_BIT)
$(V65_BASE):
	mkdir -p $@
$(V65_JSON): $(V65_SRC) $(V65_CCF) $(V65_SDC) | $(V65_BASE)
	$(YOSYS) -p 'read_verilog -defer $(V65_SRC); synth_gatemate -top $(V65_TOP) -luttree -nomx8 -json $(abspath $@)' > $(V65_BASE)/synth.log
$(V65_IMPL): $(V65_JSON) $(V65_CCF) $(V65_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(V65_JSON)) -o ccf=$(abspath $(V65_CCF)) -o out=$(abspath $@) --sdc $(abspath $(V65_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(V65_SEED) -l $(abspath $(V65_BASE)/pnr-seed$(V65_SEED).log)
$(V65_BIT): $(V65_IMPL)
	$(GMPACK) --bootaddr $(V65_BOOTADDR) $(abspath $<) $(abspath $@)
	python3 tests/qualify-ulx5m-v65-multiboot-probe.py $(abspath $@) --pnr-log $(abspath $(V65_BASE)/pnr-seed$(V65_SEED).log)
