# ULX5M-GS standalone three-button GPIO polarity and mapping probe.
# Run from bootloader-serv; SRAM bitstream only, no flash or CFG_CTRL.
SHELL := /bin/sh
BUILD := build-ulx5m-gs/button-polarity-probe
TOP := top_ulx5m_gs_button_polarity
SRC := rtl/top-ulx5m-gs-button-polarity.v
TB := tests/tb_ulx5m_button_polarity.v
CCF := data/top-ulx5m-gs-button-polarity.ccf
SDC := data/top-ulx5m-gs-button-polarity.sdc
JSON := $(BUILD)/$(TOP).json
IMPL := $(BUILD)/$(TOP).txt
BIT := $(BUILD)/$(TOP).bit
SIM := $(BUILD)/button-polarity.vvp
SEED ?= 1

.PHONY: test bit

$(BUILD):
	mkdir -p $@

$(SIM): $(SRC) $(TB) | $(BUILD)
	iverilog -g2012 -s tb_ulx5m_button_polarity -o $@ $(SRC) $(TB)

test: $(SIM)
	vvp $(SIM)

$(JSON): $(SRC) | $(BUILD)
	yosys -p 'read_verilog -defer $(SRC); synth_gatemate -top $(TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD)/synth.log

$(IMPL): $(JSON) $(CCF) $(SDC)
	nextpnr-himbaechel --device CCGM1A1 --json $(abspath $(JSON)) -o ccf=$(abspath $(CCF)) -o out=$(abspath $@) --sdc $(abspath $(SDC)) --router router2 --placer-heap-beta=0.6 --seed $(SEED) -l $(abspath $(BUILD)/pnr.log)

$(BIT): $(IMPL)
	gmpack $(abspath $(IMPL)) $(abspath $@)

bit: test $(BIT)
	sha256sum $(BIT)
