# Isolated native GateMate application-sector USB DFU test.
# Include the existing board build without changing its defaults or targets.
# Only this separate Makefile exposes the FWTN hardware writer profile.
include Makefile.ulx5m-gs

# SRAM-only native application sector USB experiment. Bounded to
# 0x201000..0x201fff and requires distinct FWTN USB arming.
# Change this seed or override it with DFU_HW_NATIVE_SEED=<number> on make.
DFU_HW_NATIVE_SEED ?= 75

DFU_HW_NATIVE_FW := $(BUILD_DIR)/dfu-hw-native/fw_ulx5m_flash_read.hex
DFU_HW_NATIVE_JSON := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-hw-native-btn2.json
DFU_HW_NATIVE_IMPL := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-hw-native-btn2.txt
DFU_HW_NATIVE_BIT := $(BUILD_DIR)/$(FLASH_TOP)-serv-dfu-hw-native-btn2.bit
DFU_HW_NATIVE_SEED_STAMP := $(BUILD_DIR)/dfu-hw-native-serv-seed.txt
.PHONY: dfu-hw-native-btn2-serv dfu-hw-native-btn2-serv-firmware test-dfu-hw-native-arm dfu-hw-native-seed-check

dfu-hw-native-btn2-serv: $(DFU_HW_NATIVE_BIT)
dfu-hw-native-btn2-serv-firmware: $(DFU_HW_NATIVE_FW)
dfu-hw-native-seed-check:
$(DFU_HW_NATIVE_SEED_STAMP): dfu-hw-native-seed-check | $(BUILD_DIR)
	@printf '%s\n' '$(DFU_HW_NATIVE_SEED)' | cmp -s - $@ || printf '%s\n' '$(DFU_HW_NATIVE_SEED)' > $@
$(DFU_HW_NATIVE_FW): $(wildcard fw/*.c) $(wildcard fw/*.h) fw/start.S fw/lnk-app.lds fw/Makefile.ulx5m-flash-read
	$(MAKE) -C fw -f Makefile.ulx5m-flash-read \
	  BUILD_DIR=../$(BUILD_DIR)/dfu-hw-native SERV=1 DFU_STREAM_ONLY=1 \
	  DFU_HW_TEST_ONLY=1 DFU_HW_NATIVE_TEST_ONLY=1
$(DFU_HW_NATIVE_JSON): $(DFU_HW_NATIVE_FW) $(PROBE_MC) $(SERV_STAMP) $(BTN2_DFU_QUAD_SRC) $(FLASH_CCF) $(FLASH_SDC) | $(BUILD_DIR)
	$(YOSYS) -p 'read_verilog -defer -DULX5M_USE_SERV -DULX5M_SERV_DFU_HW_NATIVE_TEST -DULX5M_SERV_BTN2_DFU_GATE -Icores/usb/rtl $(BTN2_DFU_QUAD_SRC); synth_gatemate -top $(FLASH_TOP) -luttree -nomx8 -json $(abspath $@)' > $(BUILD_DIR)/dfu-hw-native-serv-synth.log
$(DFU_HW_NATIVE_IMPL): $(DFU_HW_NATIVE_JSON) $(FLASH_CCF) $(FLASH_SDC) $(DFU_HW_NATIVE_SEED_STAMP)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(DFU_HW_NATIVE_JSON)) -o ccf=$(abspath $(FLASH_CCF)) -o out=$(abspath $@) --sdc $(abspath $(FLASH_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(DFU_HW_NATIVE_SEED) -l $(abspath $(BUILD_DIR)/dfu-hw-native-serv-pnr.log)
$(DFU_HW_NATIVE_BIT): $(DFU_HW_NATIVE_IMPL)
	$(GMPACK) $(abspath $(DFU_HW_NATIVE_IMPL)) $(abspath $@)

test-dfu-hw-native-arm: | $(BUILD_DIR)
	gcc -std=c11 -Wall -Wextra -Werror -O1 \
	  -DULX5M_AT25QL321_EMULATOR_TEST=1 -DULX5M_FLASH_PROGRAM_EMULATOR_TEST=1 \
	  -DULX5M_FLASH_HW_TEST=1 -DULX5M_FLASH_HW_QUAD_TEST=1 \
	  -DULX5M_FLASH_HW_NATIVE_SLOT_TEST=1 -DULX5M_FLASH_HW_HOST_TEST=1 \
	  -DULX5M_DFU_HW_TEST_ONLY=1 -DULX5M_DFU_HW_NATIVE_TEST_ONLY=1 \
	  -Ifw -Itests -o $(BUILD_DIR)/test-dfu-hw-native-arm \
	  fw/ulx5m_at25ql321.c fw/ulx5m_flash_program.c \
	  fw/ulx5m_dfu_stream.c fw/ulx5m_flash_hw_test.c \
	  tests/ulx5m-at25ql321-mock.c tests/test-ulx5m-serv-dfu-hw-native.c
	$(BUILD_DIR)/test-dfu-hw-native-arm build-ulx5m-gs/top_ulx5m_gs_normal_led.bit

