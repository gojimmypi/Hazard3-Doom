# ULX5M-GS v70: ONLY local synthesis/route/pack + offline qualification.
# Reuses vetted v66 pin constraints and v63b timing helper. NEVER programs flash.
.DEFAULT_GOAL := help
YOSYS ?= yosys
NEXTPNR ?= nextpnr-himbaechel
GMPACK ?= gmpack
DEVICE ?= CCGM1A1
V70_SEED ?= 302
V70_BASE := build-ulx5m-gs/v70-runtime-clear
V70_TOP := top_ulx5m_gs_v70_cfg_runtime_clear_probe
V70_SRC := rtl/top-ulx5m-gs-v70-cfg-runtime-clear-probe.v
V70_STREAM := rtl/ulx5m_cfg_bank_command_stream.v
V70_CCF := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.ccf
V70_SDC := data/top-ulx5m-gs-v66-cfg-pin-sense-probe.sdc
V70_JSON := $(V70_BASE)/$(V70_TOP).json
V70_IMPL := $(V70_BASE)/$(V70_TOP)-seed$(V70_SEED).txt
V70_BIT := $(V70_BASE)/$(V70_TOP)-seed$(V70_SEED)-PACK-ONLY.bit
.DELETE_ON_ERROR: $(V70_IMPL) $(V70_BIT)
.PHONY: help v70-build v70-test
help:
	@echo 'EXPERIMENTAL v70. No JTAG or flash programming target.'
	@echo 'make -f Makefile.ulx5m-v70-cfg-runtime-clear-probe v70-test'
	@echo 'make -f Makefile.ulx5m-v70-cfg-runtime-clear-probe v70-build'
v70-test:
	python3 tests/test-ulx5m-v70-cfg-runtime-clear.py
v70-build: $(V70_BIT)
$(V70_BASE):
	mkdir -p $@
$(V70_JSON): $(V70_SRC) $(V70_STREAM) $(V70_CCF) $(V70_SDC) | $(V70_BASE)
	$(YOSYS) -p 'read_verilog -defer $(V70_STREAM) $(V70_SRC); synth_gatemate -top $(V70_TOP) -luttree -nomx8 -json $(abspath $@)' > $(V70_BASE)/synth.log
$(V70_IMPL): $(V70_JSON) $(V70_CCF) $(V70_SDC)
	$(NEXTPNR) --device $(DEVICE) --json $(abspath $(V70_JSON)) -o ccf=$(abspath $(V70_CCF)) -o out=$(abspath $@) --sdc $(abspath $(V70_SDC)) --router router2 --placer-heap-beta=0.6 --seed $(V70_SEED) -l $(abspath $(V70_BASE)/pnr-seed$(V70_SEED).log)
$(V70_BIT): $(V70_IMPL)
	$(GMPACK) --reconfig --bootaddr 2101248 $(abspath $<) $(abspath $@)
	python3 tests/qualify-ulx5m-v70-cfg-runtime-clear.py $(abspath $@) --pnr-log $(abspath $(V70_BASE)/pnr-seed$(V70_SEED).log)
