# Generated outputs
/**/build/
/**/.gradle/

# Doom data files are not source code and must not be committed
/wads/*.wad
/wads/*.WAD

# Python
__pycache__/
*.py[cod]

# Visual Studio / VisualGDB per-user state
.vs/
*.user
*.suo

# Editor and OS files
*.log
*.DS_Store
*~

/**/.visualgdb/

# When Regular VC++ IntelliSense (and not nmake) is used, VisualGDB generates a Debug folder in the project root.
# This folder contains a .sln file and a .vcxproj file that are not needed for building the project and should not be committed to the repository.
# The "**" in ".**/Debug" will typically be the first section of the project GUID.
/**/VisualGDB/Hazard3-.**/Debug

/**/*.bak
/**/*.zip

# The RISC-V 440+ MB download expands to 1.5+ GB
# See install: ./scripts/setup-xpack-riscv-gcc.cmd
/bin/riscv-gcc

# Optional downloads from GH artifacts
/download

